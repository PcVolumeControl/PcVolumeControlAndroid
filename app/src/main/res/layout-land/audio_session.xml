<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
			  xmlns:tools="http://schemas.android.com/tools"
			  xmlns:app="http://schemas.android.com/apk/res-auto"
			  android:id="@+id/AUDIO_session_container"
			  android:orientation="vertical"
			  android:layout_width="wrap_content"
			  android:layout_height="match_parent"
			  android:padding="@dimen/default_padding"
			  android:layout_marginTop="@dimen/default_margin"
			  android:layout_marginBottom="@dimen/default_margin"
			  android:layout_marginStart="@dimen/default_margin_half"
			  android:layout_marginEnd="@dimen/default_margin_half"
			  android:gravity="center_horizontal"
			  android:elevation="@dimen/default_elevation"
			  android:background="@color/subtleBackground"
			  android:focusable="false"
			  android:focusableInTouchMode="false">

	<!-- Zero height and invisible: gives the column the width of the icon and name, as a visible
		 name would. The title row below is match_parent, so a detail never widens the column but
		 can use its full width. The holder keeps this text and its favourite star equal to the name's. -->
	<TextView
		android:id="@+id/AUDIO_name_width"
		android:layout_width="wrap_content"
		android:layout_height="0dp"
		android:layout_marginStart="@dimen/session_icon_size"
		android:layout_marginEnd="@dimen/default_margin_half"
		android:maxWidth="@dimen/session_name_max_width_land"
		android:maxLines="2"
		android:visibility="invisible"
		android:importantForAccessibility="no"
		android:textAppearance="@android:style/TextAppearance"
		tools:ignore="Suspicious0dp,InconsistentLayout"/>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:orientation="horizontal">

		<ImageView
			android:id="@+id/AUDIO_icon"
			android:layout_width="@dimen/session_icon_size"
			android:layout_height="@dimen/session_icon_size"
			android:layout_marginEnd="@dimen/default_margin_half"
			android:importantForAccessibility="no"
			android:scaleType="fitCenter"
			android:src="@drawable/ic_app_placeholder"/>

		<androidx.constraintlayout.widget.ConstraintLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content">

			<!-- Invisible two lines of text: they set the title's height, so the column keeps its
				 layout with or without a detail. The name and detail are drawn in exactly that height. -->
			<TextView
				android:id="@+id/AUDIO_title"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:lines="2"
				android:visibility="invisible"
				android:importantForAccessibility="no"
				android:textAppearance="@android:style/TextAppearance"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="parent"/>

			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="0dp"
				android:gravity="center"
				android:orientation="vertical"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@+id/AUDIO_title"
				app:layout_constraintBottom_toBottomOf="@+id/AUDIO_title">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center"
					android:maxWidth="@dimen/session_name_max_width_land"
					android:maxLines="2"
					android:ellipsize="end"
					android:id="@+id/AUDIO_name"
					tools:text="Channel"
					android:textAppearance="@android:style/TextAppearance"/>

				<TextView
					android:id="@+id/AUDIO_detail"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center"
					android:maxLines="1"
					android:ellipsize="end"
					android:importantForAccessibility="no"
					android:visibility="gone"
					tools:text="Big Buck Bunny - YouTube"
					tools:visibility="visible"
					android:textAppearance="@android:style/TextAppearance.Small"/>
			</LinearLayout>
		</androidx.constraintlayout.widget.ConstraintLayout>
	</LinearLayout>

	<!-- This library requires pair of the VerticalSeekBar and VerticalSeekBarWrapper classes -->
	<com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBarWrapper
		android:id="@+id/AUDIO_volume_container"
		android:layout_width="64dp"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:focusable="false"
		android:focusableInTouchMode="false">

		<com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBar
			android:id="@+id/AUDIO_volume"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:splitTrack="false"
			android:max="10"
			android:progress="3"
			android:thumb="@drawable/seekbar_thumb"
			app:seekBarRotation="CW270"/>
	</com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBarWrapper>

	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:orientation="horizontal">

		<ImageButton
			android:id="@+id/AUDIO_mute"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:minWidth="@dimen/min_touch"
			android:minHeight="@dimen/min_touch"
			android:src="@drawable/mute_checkbox"
			android:background="?android:attr/selectableItemBackgroundBorderless"/>

		<ImageButton
			android:id="@+id/AUDIO_menu"
			android:layout_width="@dimen/min_touch"
			android:layout_height="@dimen/min_touch"
			android:layout_marginStart="@dimen/default_margin"
			android:src="@drawable/ic_menu"
			android:background="?selectableItemBackground"
			android:contentDescription="@string/AUDIO_MENU_description"
			android:onClick="showAudioSessionOptions"/>
	</LinearLayout>
</LinearLayout>