<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/AUDIO_session_container"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:padding="@dimen/default_padding"
	android:layout_marginTop="@dimen/default_margin_half"
	android:layout_marginBottom="@dimen/default_margin_half"
	android:layout_marginStart="@dimen/default_margin"
	android:layout_marginEnd="@dimen/default_margin"
	android:gravity="center_horizontal"
	android:elevation="@dimen/default_elevation"
	android:background="@color/subtleBackground"
	android:focusable="false"
	android:focusableInTouchMode="false">

	<ImageView
		android:id="@+id/AUDIO_icon"
		android:layout_width="@dimen/session_icon_size"
		android:layout_height="@dimen/session_icon_size"
		android:importantForAccessibility="no"
		android:scaleType="fitCenter"
		android:src="@drawable/ic_app_placeholder"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="@+id/AUDIO_title"
		app:layout_constraintBottom_toBottomOf="@+id/AUDIO_title"/>

	<!-- Invisible two lines of text: they set the title's height, so a row is the same height with
		 or without a detail. The name and detail are drawn in exactly that height below. -->
	<TextView
		android:id="@+id/AUDIO_title"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="@dimen/default_margin"
		android:lines="2"
		android:visibility="invisible"
		android:importantForAccessibility="no"
		android:textAppearance="@android:style/TextAppearance"
		app:layout_constraintEnd_toStartOf="@+id/AUDIO_options_container"
		app:layout_constraintStart_toEndOf="@+id/AUDIO_icon"
		app:layout_constraintTop_toTopOf="parent"/>

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:gravity="center_vertical"
		android:orientation="vertical"
		app:layout_constraintStart_toStartOf="@+id/AUDIO_title"
		app:layout_constraintEnd_toEndOf="@+id/AUDIO_title"
		app:layout_constraintTop_toTopOf="@+id/AUDIO_title"
		app:layout_constraintBottom_toBottomOf="@+id/AUDIO_title">

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:maxLines="2"
			android:ellipsize="end"
			android:id="@+id/AUDIO_name"
			tools:text="Channel"
			android:textAlignment="textStart"
			android:textAppearance="@android:style/TextAppearance"/>

		<TextView
			android:id="@+id/AUDIO_detail"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:maxLines="1"
			android:ellipsize="end"
			android:textAlignment="viewStart"
			android:importantForAccessibility="no"
			android:visibility="gone"
			tools:text="Big Buck Bunny - YouTube"
			tools:visibility="visible"
			android:textAppearance="@android:style/TextAppearance.Small"/>
	</LinearLayout>

	<!-- This library requires pair of the VerticalSeekBar and VerticalSeekBarWrapper classes -->
	<FrameLayout
		android:id="@+id/AUDIO_volume_container"
		android:layout_width="match_parent"
		android:layout_height="64dp"
		android:focusable="false"
		android:focusableInTouchMode="false"
		app:layout_constraintTop_toBottomOf="@+id/AUDIO_options_container"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintRight_toRightOf="parent">

		<SeekBar
			android:id="@+id/AUDIO_volume"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:splitTrack="false"
			android:max="10"
			android:progress="3"
			android:thumb="@drawable/seekbar_thumb"/>
	</FrameLayout>

	<LinearLayout
		android:id="@+id/AUDIO_options_container"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		app:layout_constraintRight_toRightOf="parent"
		android:orientation="horizontal">

		<ImageButton
			android:id="@+id/AUDIO_menu"
			android:layout_width="@dimen/min_touch"
			android:layout_height="@dimen/min_touch"
			android:layout_marginStart="@dimen/default_margin"
			android:src="@drawable/ic_menu"
			android:background="?selectableItemBackground"
			android:contentDescription="@string/AUDIO_MENU_description"
			android:onClick="showAudioSessionOptions"/>

		<ImageButton
			android:id="@+id/AUDIO_mute"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:minWidth="@dimen/min_touch"
			android:minHeight="@dimen/min_touch"
			android:src="@drawable/mute_checkbox"
			android:background="?android:attr/selectableItemBackgroundBorderless" />

	</LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>